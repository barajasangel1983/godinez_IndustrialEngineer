# Version control
.git/
.gitignore

# Python bytecode & caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build / packaging artifacts
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Secrets — never bake into the image
.env
.env.*
!.env.example

# Development & session files
tests/
.claude/

# Database files — managed via Docker volume, not baked in
data/*.db
data/*.sqlite

# Editor / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db
