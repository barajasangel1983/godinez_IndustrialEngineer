# Godínez IndustrialEngineer — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── LangSmith (optional tracing) ─────────────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=godinez-industrial-engineer

# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── LLM Settings ─────────────────────────────────────────────────
# Model name (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
# Sampling temperature: 0.0 (deterministic) to 2.0 (creative)
LLM_TEMPERATURE=0.0

# ── LLM Endpoints ────────────────────────────────────────────────
# Tier 1: vLLM on DGX (Qwen3.6-35B-A3B). Falls back to Ollama if unreachable.
DGX_VLLM_URL=http://100.74.225.3:8001/v1
# Tier 2: Ollama local fallback (qwen3:8b). Falls back to keyword matching if unreachable.
OLLAMA_BASE_URL=http://localhost:11434

# ── Database / Persistence ────────────────────────────────────────
# "off" disables persistence (default)
# "sqlite:///data/godinez.db" for local SQLite
# "postgresql://user:pass@host:5432/dbname" for PostgreSQL
DATABASE_URL=off

# ── OEE Thresholds (%) ────────────────────────────────────────────
# Must be strictly ascending: critical < needs_improvement < good < world_class
OEE_CRITICAL=60.0
OEE_NEEDS_IMPROVEMENT=75.0
OEE_GOOD=85.0
OEE_WORLD_CLASS=90.0

# ── Bottleneck Detection (balance delay %) ────────────────────────
BOTTLENECK_CRITICAL=30
BOTTLENECK_HIGH=20
BOTTLENECK_MEDIUM=10

# ── Cost Defaults (USD) ───────────────────────────────────────────
COST_SCRAP_PER_UNIT=25.00
COST_REWORK_PER_HOUR=45.00
COST_DOWNTIME_PER_HOUR=150.00
COST_DEFECT_PER_UNIT=5.00

# ── Graph Execution ───────────────────────────────────────────────
MAX_ITERATIONS=10
GRAPH_TIMEOUT=120

# ── Config File (optional) ────────────────────────────────────────
# Path to a JSON config file that overrides .godinez_config.json
# CONFIG_FILE=/path/to/config.json
